"use client";

import { useEffect, useState } from "react";
import { vocabularyWords } from "../data/vocabulary";

const courses = [
  {
    icon: "📚",
    title: "واژگان انگلیسی",
    subtitle: "لغت، معنی، تلفظ و املا",
    color: "violet",
    href: "#vocabulary",
  },
  {
    icon: "🧩",
    title: "گرامر کاربردی",
    subtitle: "یادگیری قدم‌به‌قدم قواعد",
    color: "blue",
    href: "#grammar",
  },
  {
    icon: "🎧",
    title: "مهارت شنیداری",
    subtitle: "درک مکالمه و فایل صوتی",
    color: "orange",
    href: "#skills",
  },
  {
    icon: "💬",
    title: "مکالمه انگلیسی",
    subtitle: "تمرین صحبت کردن",
    color: "green",
    href: "#skills",
  },
  {
    icon: "📖",
    title: "درک مطلب",
    subtitle: "متن‌خوانی و پاسخ به سؤال",
    color: "pink",
    href: "#skills",
  },
  {
    icon: "✍️",
    title: "مهارت نوشتن",
    subtitle: "از جمله تا متن انگلیسی",
    color: "cyan",
    href: "#skills",
  },
];

const STORAGE_KEYS = {
  saved: "linguapro-saved-words",
  learned: "linguapro-learned-words",
};

const VOCABULARY_GOAL = 5000;

export default function Home() {
  const [active, setActive] = useState("خانه");
  const [search, setSearch] = useState("");
  const [saved, setSaved] = useState<string[]>([]);
  const [learned, setLearned] = useState<string[]>([]);
  const [storageReady, setStorageReady] = useState(false);
  const [checked, setChecked] = useState(false);
  const [selectedLevel, setSelectedLevel] = useState("همه");
  const [selectedTopic, setSelectedTopic] = useState("همه");

  const navigation = [
    { name: "خانه", icon: "⌂", href: "#home" },
    { name: "واژگان", icon: "▤", href: "#vocabulary" },
    { name: "گرامر", icon: "◈", href: "#grammar" },
    { name: "مهارت‌های زبان", icon: "◎", href: "#skills" },
    { name: "تمرین روزانه", icon: "✓", href: "#practice" },
    { name: "آزمون‌ها", icon: "▣", href: "#exams" },
  ];

  // بازیابی اطلاعات ذخیره‌شده پس از بازشدن صفحه
  useEffect(() => {
    try {
      const savedWords = localStorage.getItem(STORAGE_KEYS.saved);
      const learnedWords = localStorage.getItem(STORAGE_KEYS.learned);

      if (savedWords) {
        const parsed = JSON.parse(savedWords);
        if (Array.isArray(parsed)) setSaved(parsed);
      }

      if (learnedWords) {
        const parsed = JSON.parse(learnedWords);
        if (Array.isArray(parsed)) setLearned(parsed);
      }
    } catch {
      console.warn("بازیابی اطلاعات یادگیری انجام نشد.");
    } finally {
      setStorageReady(true);
    }
  }, []);

  // ذخیره اطلاعات در مرورگر
  useEffect(() => {
    if (!storageReady) return;

    try {
      localStorage.setItem(STORAGE_KEYS.saved, JSON.stringify(saved));
      localStorage.setItem(STORAGE_KEYS.learned, JSON.stringify(learned));
    } catch {
      console.warn("ذخیره اطلاعات یادگیری انجام نشد.");
    }
  }, [saved, learned, storageReady]);

  const topics = Array.from(
    new Set(vocabularyWords.map((word) => word.topic))
  ).sort();

  const filteredWords = vocabularyWords.filter((word) => {
    const searchableText = [
      word.word,
      word.meaning,
      word.type,
      word.example,
      word.topic,
      word.level,
    ]
      .join(" ")
      .toLowerCase();

    const matchesSearch = searchableText.includes(
      search.trim().toLowerCase()
    );

    const matchesLevel =
      selectedLevel === "همه" || word.level === selectedLevel;

    const matchesTopic =
      selectedTopic === "همه" || word.topic === selectedTopic;

    return matchesSearch && matchesLevel && matchesTopic;
  });

  const progressPercent = Math.min(
    100,
    Math.round((learned.length / VOCABULARY_GOAL) * 100)
  );

  const speakWord = (text: string) => {
    if (!("speechSynthesis" in window)) {
      window.alert("مرورگر شما از پخش تلفظ پشتیبانی نمی‌کند.");
      return;
    }

    window.speechSynthesis.cancel();

    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = "en-US";
    utterance.rate = 0.85;
    utterance.pitch = 1;

    window.speechSynthesis.speak(utterance);
  };
  const toggleSaved = (word: string) => {
    setSaved((previous) =>
      previous.includes(word)
        ? previous.filter((item) => item !== word)
        : [...previous, word]
    );
  };

  const toggleLearned = (word: string) => {
    setLearned((previous) =>
      previous.includes(word)
        ? previous.filter((item) => item !== word)
        : [...previous, word]
    );
  };

  return (
    <main className="app-shell" id="home">
      <aside className="sidebar">
        <a href="#home" className="brand">
          <span className="brand-mark">L</span>
          <span className="brand-copy">
            <strong>LinguaPro</strong>
            <small>یادگیری هوشمند زبان</small>
          </span>
        </a>

        <div className="side-label">منوی اصلی</div>

        <nav className="nav-list" aria-label="منوی اصلی">
          {navigation.map((item) => (
            <a
              href={item.href}
              key={item.name}
              className={`nav-link ${
                active === item.name ? "nav-active" : ""
              }`}
              onClick={() => setActive(item.name)}
            >
              <span className="nav-icon">{item.icon}</span>
              <span>{item.name}</span>
              {item.name === "تمرین روزانه" && (
                <span className="nav-dot" />
              )}
            </a>
          ))}
        </nav>

        <div className="side-label side-label-spaced">
          حساب کاربری
        </div>

        <a className="nav-link" href="#teachers">
          <span className="nav-icon">♧</span>
          <span>بخش معلمان</span>
        </a>

        <a className="nav-link" href="#exams">
          <span className="nav-icon">▧</span>
          <span>کلاس و آزمون</span>
        </a>

        <div className="sidebar-bottom">
          <div className="help-card">
            <span className="help-icon">✦</span>
            <strong>هر روز یک قدم جلوتر!</strong>
            <p>با تمرین منظم، انگلیسی را بهتر یاد بگیر.</p>
            <a href="#practice">شروع یادگیری ←</a>
          </div>

          <div className="profile-row">
            <div className="avatar">ز</div>
            <div className="profile-info">
              <strong>زبان‌آموز</strong>
              <small>خوش آمدی!</small>
            </div>
            <span className="profile-menu">···</span>
          </div>
        </div>
      </aside>

      <section className="main-panel">
        <header className="topbar">
          <div className="breadcrumb">
            <span>خانه</span>
            <span className="crumb-sep">/</span>
            <strong>داشبورد یادگیری</strong>
          </div>

          <div className="topbar-actions">
            <label className="search-box">
              <span>⌕</span>
              <input
                value={search}
                onChange={(event) => {
                  setSearch(event.target.value);
                  document
                    .getElementById("vocabulary")
                    ?.scrollIntoView({
                      behavior: "smooth",
                      block: "start",
                    });
                }}
                placeholder="جست‌وجوی لغت..."
                aria-label="جست‌وجوی لغت"
              />
              <kbd>جست‌وجو</kbd>
            </label>

            <button
              className="icon-button"
              aria-label="اعلان‌ها"
              title="اعلان‌ها"
              type="button"
            >
              ♧
            </button>

            <span className="language-pill">
              EN <span>↔</span> FA
            </span>
          </div>
        </header>

        <div className="page-content">
          <section className="welcome-row">
            <div>
              <div className="eyebrow">
                <span className="eyebrow-star">✦</span>
                مسیر یادگیری تو از اینجا شروع می‌شود
              </div>

              <h1>
                سلام، به دنیای{" "}
                <span className="text-gradient">انگلیسی</span>{" "}
                خوش آمدی!
              </h1>

              <p className="welcome-description">
                یاد بگیر، تمرین کن و هر روز یک قدم به تسلط بر زبان
                انگلیسی نزدیک‌تر شو.
              </p>
            </div>

            <div className="date-chip">
              <span>◷</span> فضای یادگیری شخصی تو
            </div>
          </section>

          <section className="hero-banner">
            <div className="hero-orb orb-one" />
            <div className="hero-orb orb-two" />

            <div className="hero-copy">
              <div className="hero-badge">
                <span>✦</span> شروع یک مسیر تازه
              </div>

              <h2>
                انگلیسی را فقط یاد نگیر،
                <br />
                <span>زندگی‌اش کن!</span>
              </h2>

              <p>
                از اولین لغت تا مکالمه روان؛ قدم‌به‌قدم در کنار تو هستیم.
              </p>

              <a className="hero-button" href="#courses">
                کشف مسیر یادگیری <span>←</span>
              </a>
            </div>

            <div className="hero-art" aria-hidden="true">
              <div className="book-glow" />

              <div className="floating-card float-word">
                <span className="mini-spark">✦</span>
                <div>
                  <strong>Learn</strong>
                  <small>یاد گرفتن</small>
                </div>
              </div>

              <div className="book-emoji">📚</div>

              <div className="floating-card float-score">
                <span className="score-icon">↗</span>
                <div>
                  <strong>Keep going!</strong>
                  <small>به مسیرت ادامه بده</small>
                </div>
              </div>

              <div className="orbit orbit-a" />
              <div className="orbit orbit-b" />
            </div>

            <div className="hero-bottom-note">
              <span className="live-dot" /> هر روز بهتر از دیروز
            </div>
          </section>

          <section className="stats-grid" aria-label="آمار یادگیری">
            <article className="stat-card">
              <span className="stat-icon stat-violet">▤</span>
              <div>
                <span className="stat-label">واژگان بانک فعلی</span>
                <strong>
                  {vocabularyWords.length.toLocaleString("fa-IR")}{" "}
                  <small>لغت</small>
                </strong>
                <span className="stat-note">لغات موجود در بانک</span>
              </div>
              <span className="stat-decoration">Aa</span>
            </article>

            <article className="stat-card">
              <span className="stat-icon stat-orange">⚡</span>
              <div>
                <span className="stat-label">لغات یادگرفته‌شده</span>
                <strong>
                  {learned.length.toLocaleString("fa-IR")}{" "}
                  <small>لغت</small>
                </strong>
                <span className="stat-note">ادامه بده!</span>
              </div>
              <span className="stat-decoration">✓</span>
            </article>

            <article className="stat-card">
              <span className="stat-icon stat-green">♡</span>
              <div>
                <span className="stat-label">لغات ذخیره‌شده</span>
                <strong>
                  {saved.length.toLocaleString("fa-IR")}{" "}
                  <small>لغت</small>
                </strong>
                <span className="stat-note">دفتر لغات شخصی</span>
              </div>
              <span className="stat-decoration">♥</span>
            </article>

            <article className="stat-card">
              <span className="stat-icon stat-blue">◎</span>
              <div>
                <span className="stat-label">هدف واژگان</span>
                <strong>
                  {VOCABULARY_GOAL.toLocaleString("fa-IR")}{" "}
                  <small>لغت</small>
                </strong>
                <span className="stat-note">مسیر یادگیری تو</span>
              </div>
              <span className="stat-decoration">✦</span>
            </article>
          </section>

          <section className="section-block" id="courses">
            <div className="section-heading">
              <div>
                <span className="section-kicker">LEARNING PATH</span>
                <h2>مسیر یادگیری تو</h2>
                <p>مهارتت را انتخاب کن و از همین‌جا شروع کن.</p>
              </div>

              <a className="text-link" href="#skills">
                همه مهارت‌ها <span>←</span>
              </a>
            </div>

            <div className="courses-grid">
              {courses.map((course) => (
                <a
                  className="course-card"
                  href={course.href}
                  key={course.title}
                >
                  <div className={`course-icon ${course.color}`}>
                    {course.icon}
                  </div>

                  <span className="course-arrow">↖</span>
                  <h3>{course.title}</h3>
                  <p>{course.subtitle}</p>

                  <div className="course-footer">
                    <span>مشاهده بخش</span>
                    <span className="mini-arrow">←</span>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <section className="lower-grid">
            <div
              className="section-block vocabulary-panel"
              id="vocabulary"
            >
              <div className="section-heading compact-heading">
                <div>
                  <span className="section-kicker">
                    VOCABULARY NOTEBOOK
                  </span>
                  <h2>واژگان منتخب</h2>
                  <p>
                    لغات کاربردی برای تقویت دایره واژگان
                  </p>
                </div>

                <span className="round-symbol">Aa</span>
              </div>

              {/* نوار پیشرفت هدف ۵۰۰۰ لغت */}
              <div
                style={{
                  padding: "16px",
                  marginBottom: "16px",
                  borderRadius: "14px",
                  background: "#f5f3ff",
                  border: "1px solid #e9d5ff",
                }}
              >
                <div
                  style={{
                    display: "flex",
                    justifyContent: "space-between",
                    alignItems: "center",
                    gap: "12px",
                    flexWrap: "wrap",
                    marginBottom: "10px",
                  }}
                >
                  <strong style={{ color: "#5b21b6" }}>
                    مسیر یادگیری ۵۰۰۰ لغت
                  </strong>

                  <span style={{ color: "#6d28d9", fontSize: "13px" }}>
                    {learned.length.toLocaleString("fa-IR")} از{" "}
                    {VOCABULARY_GOAL.toLocaleString("fa-IR")} لغت
                  </span>
                </div>

                <div
                  role="progressbar"
                  aria-label="پیشرفت یادگیری واژگان"
                  aria-valuemin={0}
                  aria-valuemax={VOCABULARY_GOAL}
                  aria-valuenow={learned.length}
                  style={{
                    height: "10px",
                    borderRadius: "20px",
                    background: "#ddd6fe",
                    overflow: "hidden",
                  }}
                >
                  <div
                    style={{
                      width: `${progressPercent}%`,
                      height: "100%",
                      borderRadius: "20px",
                      background:
                        "linear-gradient(90deg, #8b5cf6, #6d28d9)",
                      transition: "width 0.3s ease",
                    }}
                  />
                </div>

                <p
                  style={{
                    margin: "9px 0 0",
                    color: "#6d28d9",
                    fontSize: "12px",
                  }}
                >
                  {progressPercent.toLocaleString("fa-IR")}٪ از هدف
                  تکمیل شده است.
                </p>
              </div>

              {/* فیلترهای لغات */}
              <div
                style={{
                  display: "flex",
                  flexWrap: "wrap",
                  gap: "10px",
                  margin: "18px 0",
                }}
              >
                <label
                  style={{
                    flex: "1 1 130px",
                    fontSize: "13px",
                    color: "#64748b",
                  }}
                >
                  سطح زبان

                  <select
                    value={selectedLevel}
                    onChange={(event) =>
                      setSelectedLevel(event.target.value)
                    }
                    style={{
                      display: "block",
                      width: "100%",
                      marginTop: "6px",
                      padding: "11px",
                      border: "1px solid #e2e8f0",
                      borderRadius: "10px",
                      background: "#fff",
                      color: "#334155",
                    }}
                  >
                    <option value="همه">همه سطح‌ها</option>
                    <option value="A1">A1 ـ مقدماتی</option>
                    <option value="A2">A2 ـ پایه</option>
                    <option value="B1">B1 ـ متوسط</option>
                    <option value="B2">B2 ـ متوسط رو به بالا</option>
                    <option value="C1">C1 ـ پیشرفته</option>
                  </select>
                </label>

                <label
                  style={{
                    flex: "1 1 160px",
                    fontSize: "13px",
                    color: "#64748b",
                  }}
                >
                  موضوع

                  <select
                    value={selectedTopic}
                    onChange={(event) =>
                      setSelectedTopic(event.target.value)
                    }
                    style={{
                      display: "block",
                      width: "100%",
                      marginTop: "6px",
                      padding: "11px",
                      border: "1px solid #e2e8f0",
                      borderRadius: "10px",
                      background: "#fff",
                      color: "#334155",
                    }}
                  >
                    <option value="همه">همه موضوع‌ها</option>

                    {topics.map((topic) => (
                      <option value={topic} key={topic}>
                        {topic}
                      </option>
                    ))}
                  </select>
                </label>

                <button
                  type="button"
                  onClick={() => {
                    setSelectedLevel("همه");
                    setSelectedTopic("همه");
                    setSearch("");
                  }}
                  style={{
                    alignSelf: "end",
                    padding: "11px 14px",
                    border: "1px solid #e2e8f0",
                    borderRadius: "10px",
                    background: "#f8fafc",
                    color: "#475569",
                    cursor: "pointer",
                  }}
                >
                  پاک‌کردن فیلترها
                </button>
              </div>

              {/* فهرست لغات */}
              <div className="word-list">
                {filteredWords.map((word) => {
                  const isSaved = saved.includes(word.word);
                  const isLearned = learned.includes(word.word);

                  return (
                    <article className="word-card" key={word.word}>
                      <div className="word-letter">
                        {word.word.charAt(0)}
                      </div>

                      <div className="word-main">
                        <div className="word-title-row">
                          <strong>{word.word}</strong>
                          <button
                            type="button"
                            onClick={() => speakWord(word.word)}
                            aria-label={`شنیدن تلفظ ${word.word}`}
                            title="شنیدن تلفظ انگلیسی"
                            style={{
                              border: "1px solid #ddd6fe",
                              background: "#f5f3ff",
                              color: "#6d28d9",
                              borderRadius: "9px",
                              width: "32px",
                              height: "32px",
                              display: "inline-flex",
                              alignItems: "center",
                              justifyContent: "center",
                              cursor: "pointer",
                              fontSize: "15px",
                              flexShrink: 0,
                            }}
                          >
                            🔊
                          </button>
                          <span className="word-type">{word.type}</span>
                        </div>

                        <span className="phonetic">
                          {word.phonetic}
                        </span>

                        <p>{word.meaning}</p>

                        <div
  style={{
    marginTop: "10px",
    padding: "12px",
    borderRadius: "12px",
    background: "#f8fafc",
    border: "1px solid #e2e8f0",
  }}
>
  <div
    style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      gap: "10px",
      marginBottom: "8px",
    }}
  >
    <span
      dir="rtl"
      style={{ fontSize: "12px", color: "#64748b", fontWeight: 600 }}
    >
      مثال در جمله
    </span>
    <button
      type="button"
      onClick={() => speakWord(word.example)}
      aria-label="شنیدن تلفظ جمله مثال"
      title="شنیدن تلفظ جمله مثال"
      style={{
        border: "1px solid #ddd6fe",
        background: "#f5f3ff",
        color: "#6d28d9",
        borderRadius: "9px",
        padding: "5px 9px",
        cursor: "pointer",
        fontSize: "12px",
        whiteSpace: "nowrap",
      }}
    >
      🔊 شنیدن جمله
    </button>
  </div>
  <small
    className="word-example"
    dir="ltr"
    style={{ display: "block", textAlign: "left", lineHeight: 1.8 }}
  >
    {word.example}
  </small>
</div>
                      </div>

                      <div
                        style={{
                          display: "flex",
                          flexWrap: "wrap",
                          alignItems: "center",
                          gap: "6px",
                        }}
                      >
                        <button
                          type="button"
                          className={`save-word ${isSaved ? "saved" : ""}`}
                          onClick={() => toggleSaved(word.word)}
                          aria-label={
                            isSaved
                              ? "حذف از لغات ذخیره‌شده"
                              : "ذخیره لغت"
                          }
                          title={
                            isSaved
                              ? "حذف از دفتر لغات"
                              : "ذخیره در دفتر لغات"
                          }
                        >
                          {isSaved ? "♥" : "♡"}
                        </button>

                        <button
                          type="button"
                          onClick={() => toggleLearned(word.word)}
                          aria-pressed={isLearned}
                          style={{
                            border: "1px solid #bbf7d0",
                            background: isLearned ? "#dcfce7" : "#fff",
                            color: "#15803d",
                            borderRadius: "10px",
                            padding: "7px 10px",
                            cursor: "pointer",
                            whiteSpace: "nowrap",
                            fontSize: "12px",
                          }}
                          title={
                            isLearned
                              ? "لغت یاد گرفته شده؛ برای لغو کلیک کن"
                              : "علامت‌گذاری به‌عنوان یادگرفته‌شده"
                          }
                        >
                          {isLearned ? "✓ یاد گرفتم" : "یاد گرفتم"}
                        </button>
                      </div>
                    </article>
                  );
                })}

                {filteredWords.length === 0 && (
                  <p className="empty-state">
                    لغتی پیدا نشد. املای کلمه یا معنی فارسی را بررسی کن.
                  </p>
                )}
              </div>

              <div className="panel-footer">
                <span>
                  لغات نمایش‌داده‌شده:{" "}
                  {filteredWords.length.toLocaleString("fa-IR")}
                </span>

                <span>
                  ذخیره‌شده‌ها: {saved.length.toLocaleString("fa-IR")}
                </span>

                <span>
                  یادگرفته‌شده‌ها:{" "}
                  {learned.length.toLocaleString("fa-IR")}
                </span>
              </div>
            </div>

            {/* تمرین روزانه */}
            <div
              className="section-block practice-panel"
              id="practice"
            >
              <div className="section-heading compact-heading">
                <div>
                  <span className="section-kicker">DAILY PRACTICE</span>
                  <h2>تمرین امروز</h2>
                  <p>با یک تمرین کوتاه شروع کن.</p>
                </div>

                <span className="practice-emoji">✍️</span>
              </div>

              <div className="practice-box">
                <div className="practice-label">
                  <span>تمرین واژگان</span>
                  <span className="difficulty">آسان</span>
                </div>

                <h3>
                  معنی کلمهٔ <span dir="ltr">Beautiful</span> چیست؟
                </h3>

                <p className="practice-hint">
                  گزینهٔ درست را انتخاب کن.
                </p>

                <div className="answer-list">
                  <button
                    type="button"
                    className={`answer-option ${
                      checked ? "incorrect" : ""
                    }`}
                    onClick={() => setChecked(false)}
                  >
                    <span className="answer-letter">A</span> بزرگ
                  </button>

                  <button
                    type="button"
                    className={`answer-option ${
                      checked ? "correct" : ""
                    }`}
                    onClick={() => setChecked(true)}
                  >
                    <span className="answer-letter">B</span> زیبا
                    <span className="answer-check">
                      {checked ? "✓" : ""}
                    </span>
                  </button>

                  <button
                    type="button"
                    className="answer-option"
                    onClick={() => setChecked(false)}
                  >
                    <span className="answer-letter">C</span> سریع
                  </button>
                </div>

                {checked && (
                  <p className="feedback-success">
                    آفرین! پاسخ درست است. Beautiful یعنی «زیبا».
                  </p>
                )}

                <button
                  type="button"
                  className="check-answer"
                  onClick={() => setChecked(true)}
                >
                  {checked ? "پاسخ بررسی شد ✓" : "بررسی پاسخ"}
                  <span>←</span>
                </button>
              </div>
            </div>
          </section>

          {/* بخش معلمان */}
          <section className="teacher-banner" id="teachers">
            <div className="teacher-symbol">♧</div>

            <div className="teacher-copy">
              <span className="section-kicker">FOR TEACHERS</span>
              <h2>فضایی برای آموزش بهتر</h2>
              <p>
                ساخت کلاس، طراحی آزمون و پیگیری پیشرفت زبان‌آموزان؛
                در مسیر توسعه سامانه.
              </p>
            </div>

            <a href="#exams" className="teacher-button">
              بخش معلمان <span>←</span>
            </a>
          </section>

          {/* بخش‌های آموزشی آینده */}
          <section className="section-block future-section" id="grammar">
            <div className="section-heading compact-heading">
              <div>
                <span className="section-kicker">
                  COMING INTO THE LEARNING PATH
                </span>
                <h2>ادامه مسیر تو</h2>
                <p>
                  بخش‌های آموزشی در مراحل بعدی توسعه کامل می‌شوند.
                </p>
              </div>
            </div>

            <div className="future-grid" id="exams">
              <div className="future-card">
                <span>📝</span>
                <div>
                  <strong>آزمون آنلاین</strong>
                  <p>آزمون‌های موضوعی و تعیین سطح</p>
                </div>
                <span className="future-tag">در مسیر توسعه</span>
              </div>

              <div className="future-card">
                <span>🧠</span>
                <div>
                  <strong>گرامر مرحله‌ای</strong>
                  <p>آموزش قواعد با مثال و تمرین</p>
                </div>
                <span className="future-tag">در مسیر توسعه</span>
              </div>

              <div className="future-card" id="skills">
                <span>🎙️</span>
                <div>
                  <strong>مکالمه و شنیدار</strong>
                  <p>تمرین مهارت‌های ارتباطی</p>
                </div>
                <span className="future-tag">در مسیر توسعه</span>
              </div>
            </div>
          </section>
        </div>
      </section>
    </main>
  );
}



